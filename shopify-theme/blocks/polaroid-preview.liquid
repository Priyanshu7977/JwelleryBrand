{% schema %}
{
  "name": "Polaroid Keepsake Preview",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Keepsake Caption",
      "default": "Fujifilm Retro Photographic Print Included"
    }
  ]
}
{% endschema %}

<div class="polaroid-frame max-w-xs mx-auto my-4 text-center">
  <div class="aspect-[4/5] bg-[#F3ECE1] rounded-sm overflow-hidden mb-3">
    <img src="{{ 'polaroids-20.jpg' | asset_url }}" alt="Polaroid Memory" class="w-full h-full object-cover" />
  </div>
  <p class="font-serif text-xs italic text-[#1E1A17] font-medium">{{ block.settings.caption }}</p>
</div>
