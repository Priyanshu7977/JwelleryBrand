{% schema %}
{
  "name": "Star Rating",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Star Rating",
      "default": 5
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count Label",
      "default": "1,000+ Happy Clients"
    }
  ]
}
{% endschema %}

<div class="inline-flex items-center gap-2 text-xs font-mono text-[#A37F3B] py-1">
  <div class="flex gap-0.5 text-sm">
    {% for i in (1..block.settings.stars) %}
      <span>★</span>
    {% endfor %}
  </div>
  <span class="text-[#786E65] font-sans font-medium">{{ block.settings.review_count }}</span>
</div>
