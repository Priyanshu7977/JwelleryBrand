{% schema %}
{
  "name": "WhatsApp Concierge CTA",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Chat with Mumbai Atelier Stylist"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Phone Number (with Country Code)",
      "default": "917718825792"
    }
  ]
}
{% endschema %}

<div class="my-3">
  <a
    href="https://wa.me/{{ block.settings.whatsapp_number }}?text=Hi%20Celestia%20Atelier,%20I%20need%20styling%20assistance."
    target="_blank"
    class="w-full min-h-[44px] h-11 px-5 rounded-full border border-emerald-600/50 bg-[#ECFDF5] text-emerald-950 text-xs uppercase font-mono tracking-wider font-bold transition-all flex items-center justify-center gap-2 hover:bg-emerald-100 no-underline cursor-pointer"
  >
    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    <span>{{ block.settings.btn_label }}</span>
  </a>
</div>
