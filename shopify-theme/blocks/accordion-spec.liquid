{% schema %}
{
  "name": "Collapsible Specifications",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accordion Heading",
      "default": "Material, Sizing & Atelier Care"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Accordion Content",
      "default": "<p><strong>Base Core:</strong> Surgical-grade 316L Stainless Steel & Pure Brass</p><p><strong>Plating:</strong> 18K Real Gold Physical Vapour Deposition (PVD)</p><p><strong>Water Resistance:</strong> 100% Shower, Perfume & Lotion Safe</p><p><strong>Dispatch:</strong> Same-day in Mumbai, 2-4 business days Pan-India</p>"
    }
  ]
}
{% endschema %}

<details class="group border-b border-[#D8C39A]/40 py-3 my-2 cursor-pointer">
  <summary class="flex items-center justify-between text-xs uppercase font-mono tracking-wider text-[#1E1A17] font-bold list-none">
    <span>{{ block.settings.heading }}</span>
    <span class="text-sm text-[#A37F3B] group-open:rotate-180 transition-transform duration-300">▾</span>
  </summary>
  <div class="pt-3 text-xs text-[#423C36] leading-relaxed space-y-2 font-sans">
    {{ block.settings.content }}
  </div>
</details>
