<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{{ shop.name }} &ndash; Private Atelier Opening</title>
    {{ 'celestia.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="bg-[#181411] text-[#FAF7F0] min-h-screen flex items-center justify-center p-6 text-center">
    <div class="max-w-md space-y-6">
      <h1 class="font-serif text-4xl uppercase tracking-widest text-[#D8C39A]">
        CEL<span class="italic font-light lowercase">estia</span>
      </h1>
      <p class="text-xs uppercase font-mono tracking-widest text-[#EDE6DA]/70">
        The Private Mumbai Atelier Opening Soon
      </p>
      {{ content_for_layout }}
    </div>
  </body>
</html>
