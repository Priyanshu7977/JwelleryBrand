<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <meta name="theme-color" content="#FAF7F0">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <!-- iOS & Safari Specific Mobile Optimizations -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="CELestia">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Luxury Typography Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@400;600;700&family=Great+Vibes&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Pinyon+Script&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS Engine with Celestia Design Tokens -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'pearl-50': '#FAF8F5',
              'pearl-100': '#F5EFE6',
              'pearl-200': '#EBDDCB',
              'warm-ivory-100': '#FAF7F0',
              'ivory-100': '#FDFBF7',
              'champagne-100': '#F6EDE0',
              'champagne-200': '#EFE0C9',
              'champagne-300': '#D8C39A',
              'champagne-400': '#C2A875',
              'gold-dark': '#A37F3B',
              'gold-light': '#F4E8D0',
              'obsidian': '#1E1A17',
              'obsidian-200': '#38312B',
              'obsidian-soft': '#423C36',
              'obsidian-muted': '#786E65',
              'blush-50': '#FBF6F3',
              'blush-100': '#F7EDE7',
              'blush-200': '#EADCD5',
              'sand': '#F3ECE1',
              'espresso-deep': '#181411',
              'espresso-charcoal': '#251F1B',
            },
            fontFamily: {
              sans: ['Montserrat', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              serif: ['Montserrat', 'Georgia', 'serif'],
              zapfino: ['Alex Brush', 'Great Vibes', 'cursive'],
              mono: ['ui-monospace', 'SFMono-Regular', 'Menlo', 'monospace'],
            }
          }
        }
      }
    </script>

    <!-- Celestia Theme Stylesheet -->
    {{ 'celestia.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="gradient selection:bg-[#D8C39A]/40 selection:text-[#1E1A17] bg-[#FAF7F0] text-[#1E1A17]">
    <a class="sr-only focus:not-sr-only focus:p-4 focus:bg-white focus:text-black focus:absolute focus:z-50" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus:none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- Luxury Drawer & Modal Overlays -->
    {% render 'cart-drawer' %}
    {% render 'quick-view-modal' %}
    {% render 'concierge-modal' %}
    {% render 'entrance-modal' %}

    <!-- Theme Core Scripts -->
    {{ 'celestia.js' | asset_url | script_tag }}
  </body>
</html>
