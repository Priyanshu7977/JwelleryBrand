[
  {
    "name": "theme_info",
    "theme_name": "Celestia Luxury Atelier",
    "theme_version": "2.0.0",
    "theme_author": "Celestia Haute Adornments",
    "theme_documentation_url": "https://celestia-jewellery-live.surge.sh",
    "theme_support_url": "https://jwellery-brand.vercel.app/contact"
  },
  {
    "name": "Branding & Atelier Identity",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Custom Brand Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 140,
        "unit": "px",
        "label": "Custom Logo Width"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand Tagline",
        "default": "redefined for all"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp Concierge Phone (with country code)",
        "default": "917718825792"
      },
      {
        "type": "text",
        "id": "studio_address",
        "label": "Physical Atelier Coordinates",
        "default": "Bandra West Atelier • Mumbai 400050"
      }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show Announcement Bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text_1",
        "label": "Announcement 1",
        "default": "Complimentary Pan-India Express Shipping & Gift Packaging"
      },
      {
        "type": "text",
        "id": "announcement_text_2",
        "label": "Announcement 2",
        "default": "Same-Day Mumbai Delivery • 100% Anti-Tarnish Guarantee"
      }
    ]
  },
  {
    "name": "Social Media Links",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram Profile Link"
      },
      {
        "type": "url",
        "id": "social_whatsapp_link",
        "label": "WhatsApp Concierge Link"
      }
    ]
  }
]
