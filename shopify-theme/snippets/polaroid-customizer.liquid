<!-- CELESTIA BESPOKE POLAROID & WAX SEAL CUSTOMIZER (LINE-ITEM PROPERTIES) -->
<div class="space-y-4 p-5 rounded-2xl bg-[#FAF8F5] border border-[#D8C39A]/40 shadow-xs">
  <div class="flex items-center gap-2 text-xs font-serif font-bold text-[#1E1A17]">
    <span class="text-base">📸</span>
    <span>Add Custom Fujifilm Polaroid & Wax-Sealed Note</span>
  </div>

  <!-- Polaroid Photo Upload -->
  <div class="space-y-1.5">
    <label class="block text-[11px] font-mono uppercase tracking-wider text-[#1E1A17] font-semibold">
      Upload Polaroid Photo (Optional):
    </label>
    <input
      type="file"
      id="PolaroidUploadInput"
      name="properties[Polaroid Photo]"
      accept="image/*"
      class="w-full text-xs text-[#786E65] file:mr-3 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-[#1E1A17] file:text-white hover:file:bg-[#38312B] cursor-pointer"
    />
  </div>

  <!-- Handwritten Wax-Seal Message -->
  <div class="space-y-1.5">
    <label class="block text-[11px] font-mono uppercase tracking-wider text-[#1E1A17] font-semibold">
      Handwritten Note for Wax Seal:
    </label>
    <textarea
      id="PolaroidNoteInput"
      name="properties[Handwritten Note]"
      rows="2"
      placeholder="Write your custom personal message..."
      class="w-full p-3 rounded-xl border border-[#D8C39A]/50 text-xs bg-white text-[#1E1A17] placeholder:text-[#786E65]/50 focus:outline-none focus:border-[#A37F3B]"
    ></textarea>
  </div>

  <!-- Live Visual Preview -->
  <div class="polaroid-frame max-w-[200px] mx-auto text-center mt-2">
    <img id="PolaroidImagePreview" src="" alt="Polaroid Preview" class="w-full aspect-square object-cover rounded-xs hidden mb-2" />
    <p id="PolaroidNotePreview" class="font-zapfino text-sm text-[#1E1A17] italic">With Love & Grace</p>
  </div>
</div>
