<!-- CELESTIA SLIDE-OVER BAG DRAWER (OS 2.0 AJAX) -->
<div id="CelestiaCartDrawer" class="fixed inset-0 z-50 overflow-hidden flex justify-end animate-fade-in hidden">
  <!-- Backdrop Overlay -->
  <div id="CelestiaCartBackdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs transition-opacity cursor-pointer"></div>

  <!-- Slide-over Panel -->
  <div class="relative w-full max-w-full sm:max-w-md bg-[#FAF7F0] h-full h-[100dvh] max-h-[100dvh] shadow-2xl flex flex-col overflow-hidden z-10 border-l border-[#D8C39A]/60">
    
    <!-- Drawer Header -->
    <div class="px-4 py-3 pt-safe border-b border-[#D8C39A]/40 bg-[#FAF8F5] shrink-0 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-[#D8C39A]/20 flex items-center justify-center text-[#A37F3B]">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        </div>
        <div>
          <h2 class="font-serif text-base sm:text-lg font-bold text-[#1E1A17] leading-none">Your Curated Bag</h2>
          <p class="text-[10px] text-[#786E65] font-sans font-medium mt-0.5">Complimentary express shipping across India</p>
        </div>
      </div>
      <button id="CelestiaCartClose" class="p-2 text-[#786E65] hover:text-[#1E1A17] rounded-full hover:bg-[#D8C39A]/20 transition-colors cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Free Shipping Progress Bar -->
    <div class="px-4 py-2 bg-[#D8C39A]/15 border-b border-[#D8C39A]/30 text-xs text-center font-mono">
      <span>✨ <strong>FREE Express Shipping</strong> on all prepaid atelier orders</span>
    </div>

    <!-- Cart Body -->
    <div class="flex-1 overflow-y-auto p-4 space-y-3 scroll-touch">
      <!-- Empty State -->
      <div id="CelestiaCartEmpty" class="text-center py-16 space-y-4 hidden">
        <div class="w-16 h-16 rounded-full bg-[#D8C39A]/20 mx-auto flex items-center justify-center text-[#A37F3B]">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        </div>
        <h3 class="font-serif text-xl text-[#1E1A17]">Your Bag Is Empty</h3>
        <p class="text-xs text-[#786E65] max-w-xs mx-auto">Explore our anti-tarnish fine jewellery, bangles, and bespoke gift hampers.</p>
        <a href="/collections/all" class="btn-primary inline-flex text-xs">Explore Collections</a>
      </div>

      <!-- Filled State Items Container -->
      <div id="CelestiaCartFilled" class="space-y-3">
        <div id="CelestiaCartItems" class="space-y-3">
          <!-- Populated dynamically via celestia.js -->
        </div>
      </div>
    </div>

    <!-- Footer Checkout Summary -->
    <div class="p-4 pb-safe bg-[#FAF8F5] border-t border-[#D8C39A]/50 space-y-3 shrink-0 shadow-lg">
      <div class="space-y-1 text-xs">
        <div class="flex justify-between items-center text-[#1E1A17]">
          <div>
            <span class="font-serif text-sm font-bold">Estimated Total</span>
            <span class="text-[10px] text-[#786E65] block">Taxes included • Free Pan-India Shipping</span>
          </div>
          <span id="CelestiaCartGrandTotal" class="font-mono font-bold text-lg text-[#A37F3B]">₹0</span>
        </div>
      </div>

      <!-- Prepaid Discount Badge -->
      <div class="px-2.5 py-1 bg-emerald-50 rounded-lg border border-emerald-300/70 flex items-center justify-between text-[11px] text-emerald-950">
        <span class="font-medium">⚡ Extra ₹50 Off on UPI / Prepaid</span>
        <span class="font-mono font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded-full text-[9px] uppercase">Instant</span>
      </div>

      <!-- CTAs -->
      <div class="space-y-2 pt-1">
        <!-- Direct Checkout -->
        <a
          href="/checkout"
          class="w-full min-h-[48px] h-12 flex items-center justify-between px-5 rounded-full bg-[#1E1A17] text-[#FAF7F0] hover:bg-[#38312B] active:scale-[0.98] transition-all font-sans text-xs uppercase tracking-widest font-bold shadow-lg cursor-pointer group no-underline"
        >
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#D8C39A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span>Proceed to Checkout</span>
          </div>
          <div class="flex items-center gap-1.5 font-mono text-[#F4E8D0]">
            <span id="CelestiaCartSubtotal">₹0</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </div>
        </a>

        <!-- WhatsApp Checkout -->
        <a
          href="https://wa.me/{{ settings.whatsapp_number | default: '917718825792' }}?text=Hi%20Celestia%20Atelier,%20I%20would%20like%20to%20place%20an%20instant%20order%20for%20my%20bag."
          target="_blank"
          class="w-full min-h-[44px] h-11 flex items-center justify-center gap-2 px-5 rounded-full bg-emerald-800 hover:bg-emerald-900 active:scale-[0.98] text-white transition-all font-sans text-xs uppercase tracking-wider font-bold shadow-sm cursor-pointer no-underline"
        >
          <span>Instant WhatsApp Checkout</span>
        </a>
      </div>

      <div class="text-center text-[10px] font-mono text-[#786E65]">
        🛡️ 100% Anti-Tarnish Lifetime Guarantee • Mumbai Handcrafted
      </div>
    </div>
  </div>
</div>
