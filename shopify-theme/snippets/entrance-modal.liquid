<!-- CELESTIA CIRCLE ENTRANCE MODAL -->
<div id="CelestiaEntranceModal" class="fixed inset-0 z-[200] flex items-center justify-center p-3 sm:p-6 bg-black/80 backdrop-blur-md hidden">
  <div class="relative z-10 w-full max-w-md max-h-[90dvh] overflow-y-auto bg-[#181411] border border-[#D8C39A]/40 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5 text-center text-[#FAF7F0] scroll-touch pb-safe">
    
    <!-- Close Button -->
    <button data-dismiss-entrance class="absolute top-4 right-4 p-2 rounded-full bg-[#251F1B] hover:bg-[#D8C39A] text-[#FAF7F0] hover:text-[#181411] transition-all cursor-pointer">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <div class="space-y-1.5">
      <span class="px-3.5 py-1 rounded-full bg-[#251F1B] border border-[#D8C39A]/40 text-[10px] font-mono uppercase tracking-widest text-[#D8C39A]">
        ✨ Celestia Private Circle
      </span>
      <h2 class="font-serif text-3xl text-[#FAF7F0] font-bold">CEL<span class="italic font-light lowercase text-[#D8C39A]">estia</span></h2>
      <p class="text-[10px] font-sans tracking-[0.25em] uppercase text-[#D8C39A] font-bold">redefined for all</p>
    </div>

    <p class="text-xs text-[#FAF7F0]/80 font-sans max-w-xs mx-auto leading-relaxed">
      Welcome to the private digital salon of Celestia Atelier. Explore our anti-tarnish fine jewellery, sculpted cuffs, and bespoke polaroid gifting hampers.
    </p>

    <div class="space-y-3 pt-2">
      <button
        data-dismiss-entrance
        class="w-full min-h-[48px] h-12 rounded-full bg-[#D8C39A] text-[#181411] hover:bg-[#E5D2AD] text-xs uppercase font-mono tracking-widest font-bold transition-all shadow-md cursor-pointer"
      >
        Enter Atelier As Guest
      </button>

      {% if shop.customer_accounts_enabled %}
        <a
          href="{{ routes.account_login_url }}"
          class="block text-[11px] uppercase font-mono tracking-wider text-[#D8C39A] hover:underline"
        >
          Sign In to Member Bag →
        </a>
      {% endif %}
    </div>
  </div>
</div>
