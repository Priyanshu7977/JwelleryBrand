<!-- CELESTIA DYNAMIC QUICK VIEW MODAL (OS 2.0 AJAX) -->
<div id="CelestiaQuickViewModal" class="fixed inset-0 z-[110] flex items-center justify-center p-4 md:p-8 hidden">
  <div id="CelestiaQuickViewBackdrop" class="fixed inset-0 bg-black/60 backdrop-blur-md transition-opacity cursor-pointer"></div>

  <div class="relative w-full max-w-3xl bg-[#FAF7F0] rounded-3xl shadow-2xl overflow-hidden z-10 border border-[#D8C39A]/50 max-h-[90dvh] flex flex-col md:flex-row animate-scale-up">
    <!-- Close Button -->
    <button id="CelestiaQuickViewClose" class="absolute top-4 right-4 z-20 p-2.5 bg-white/80 hover:bg-white rounded-full text-[#1E1A17] shadow-sm transition-all cursor-pointer">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <!-- Product Image -->
    <div class="w-full md:w-1/2 p-6 bg-[#F3ECE1] flex items-center justify-center">
      <img id="QuickViewImage" src="" alt="Product Preview" class="max-h-72 w-full object-contain rounded-2xl shadow-md" />
    </div>

    <!-- Product Info & Add Form -->
    <div class="w-full md:w-1/2 p-6 md:p-8 flex flex-col justify-between overflow-y-auto scroll-touch pb-safe">
      <div class="space-y-3">
        <span class="text-[10px] uppercase font-mono tracking-widest text-[#A37F3B] font-bold block">Celestia Haute Adornments</span>
        <h2 id="QuickViewTitle" class="font-serif text-2xl text-[#1E1A17] font-bold leading-tight"></h2>
        <div id="QuickViewPrice" class="font-mono text-xl text-[#A37F3B] font-bold"></div>
        <div id="QuickViewDescription" class="text-xs text-[#423C36] leading-relaxed line-clamp-4"></div>
      </div>

      <!-- Quick Add Form -->
      <form method="post" action="/cart/add" class="pt-6 space-y-3">
        <input type="hidden" name="id" id="QuickViewVariantId" value="" />
        <button
          type="submit"
          class="btn-primary w-full min-h-[48px] h-12 text-xs uppercase tracking-wider font-bold"
        >
          <span>Add To Curated Bag</span>
          <svg class="w-4 h-4 text-[#D8C39A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </form>
    </div>
  </div>
</div>
