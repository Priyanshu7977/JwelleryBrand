{% comment %}
  CELESTIA LUXURY PRODUCT CARD
  Renders an editorial card with anti-tarnish guarantee and 1-click add to bag
{% endcomment %}

<div class="group relative flex flex-col bg-[#FAF8F5] rounded-3xl p-3 sm:p-4 border border-[#D8C39A]/30 hover:border-[#D8C39A] shadow-xs hover:shadow-xl transition-all duration-500 selection:bg-[#D8C39A]/40">
  <!-- Image Gallery & Badges -->
  <div class="relative aspect-square w-full rounded-2xl overflow-hidden bg-[#F3ECE1] mb-3.5">
    <a href="{{ product.url }}" class="block w-full h-full">
      {%- if product.featured_media != blank -%}
        <img
          src="{{ product.featured_media | image_url: width: 800 }}"
          alt="{{ product.featured_media.alt | escape | default: product.title }}"
          class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        >
        {%- if product.media[1] != blank -%}
          <img
            src="{{ product.media[1] | image_url: width: 800 }}"
            alt="{{ product.media[1].alt | escape | default: product.title }}"
            class="absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-700 opacity-0 group-hover:opacity-100"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center text-[#D8C39A]">
          {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
        </div>
      {%- endif -%}
    </a>

    <!-- Top Badges -->
    <div class="absolute top-2.5 left-2.5 flex flex-col gap-1 z-10 pointer-events-none">
      <span class="px-2.5 py-1 rounded-full bg-[#1E1A17]/85 backdrop-blur-xs text-[#FAF7F0] text-[9.5px] uppercase font-mono tracking-widest font-bold">
        Anti-Tarnish
      </span>
      {% if product.tags contains 'bestseller' or product.tags contains 'Bestseller' %}
        <span class="px-2.5 py-1 rounded-full bg-[#D8C39A] text-[#1E1A17] text-[9.5px] uppercase font-mono tracking-widest font-bold">
          Bestseller
        </span>
      {% endif %}
    </div>

    <!-- Quick View Trigger -->
    <button
      type="button"
      data-quick-view-handle="{{ product.handle }}"
      class="absolute bottom-2.5 right-2.5 p-2.5 rounded-full bg-white/90 hover:bg-white text-[#1E1A17] shadow-md transition-all sm:opacity-0 sm:group-hover:opacity-100 cursor-pointer"
      title="Quick View"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
    </button>
  </div>

  <!-- Product Details -->
  <div class="flex-1 flex flex-col justify-between space-y-2">
    <div>
      <span class="text-[10px] uppercase tracking-widest text-[#A37F3B] font-semibold font-mono block">
        {{ product.type | default: 'Fine Adornment' }}
      </span>
      <h3 class="font-serif text-sm sm:text-base font-bold text-[#1E1A17] leading-snug line-clamp-1 hover:text-[#A37F3B] transition-colors">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
    </div>

    <div class="flex items-center justify-between pt-1">
      <div class="flex items-baseline gap-1.5">
        <span class="font-mono text-sm sm:text-base font-bold text-[#1E1A17]">
          {{ product.price | money }}
        </span>
        {% if product.compare_at_price > product.price %}
          <span class="font-mono text-xs text-[#786E65] line-through">
            {{ product.compare_at_price | money }}
          </span>
        {% endif %}
      </div>

      <!-- Quick Add to Bag Action Button -->
      {% if product.available %}
        <button
          type="button"
          data-quick-add
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          class="min-h-[38px] h-9 px-3.5 rounded-full bg-[#1E1A17] hover:bg-[#38312B] text-[#FAF7F0] text-[11px] uppercase font-mono tracking-wider font-bold transition-all shadow-xs flex items-center gap-1.5 cursor-pointer"
        >
          <span>Add</span>
          <svg class="w-3 h-3 text-[#D8C39A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </button>
      {% else %}
        <span class="text-[10px] font-mono text-[#786E65] uppercase font-bold">Reserved</span>
      {% endif %}
    </div>
  </div>
</div>
