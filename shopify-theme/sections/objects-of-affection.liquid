{% schema %}
{
  "name": "Act 04 — Affection Objects",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 04 — Objects of Affection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Little Things That Become Your Moments"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Curated Products Collection"
    }
  ],
  "presets": [
    {
      "name": "Act 04 — Affection Objects"
    }
  ]
}
{% endschema %}

{% assign collection = collections[section.settings.collection] %}

<section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#FAF7F0] border-b border-[#D8C39A]/30">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <div class="text-center space-y-3 max-w-2xl mx-auto">
      <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
        {{ section.settings.act_tag }}
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-bold uppercase text-[#1E1A17]">
        {{ section.settings.heading }}
      </h2>
      <p class="text-xs sm:text-sm text-[#423C36] leading-relaxed">
        Sculpted bangles with size precision (2.4, 2.6, 2.8), waterproof gold cuffs, and iridescent pearls designed for effortless daily layering.
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% if collection != blank and collection.products.size > 0 %}
        {% for product in collection.products limit: 4 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="p-4 bg-white rounded-3xl border border-[#D8C39A]/30 space-y-3">
            <div class="aspect-square bg-[#F3ECE1] rounded-2xl flex items-center justify-center text-[#D8C39A]">
              {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover' }}
            </div>
            <h4 class="font-serif text-sm font-bold text-[#1E1A17]">Signature Piece {{ i }}</h4>
            <p class="font-mono text-sm text-[#A37F3B] font-bold">₹150</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</section>
