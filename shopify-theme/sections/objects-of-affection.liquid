{% schema %}
{
  "name": "Act 04 — Objects Affection",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 04 — The Celestia Edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objects of affection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Curated Products Collection"
    }
  ],
  "presets": [
    {
      "name": "Act 04 — Objects Affection"
    }
  ]
}
{% endschema %}

{% assign collection = collections[section.settings.collection] %}

<section
  id="objects-of-affection"
  class="relative w-full py-16 sm:py-20 md:py-24 px-4 sm:px-6 md:px-10 lg:px-14 bg-[#FAF7F0] overflow-hidden border-t border-[#D8C39A]/40"
>
  <!-- Ambient Atmosphere -->
  <div class="absolute inset-0 bg-noise opacity-20 pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#D8C39A]/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto space-y-10 sm:space-y-12 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[#D8C39A]/40 pb-6 sm:pb-8">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAF8F5] border border-[#D8C39A]/80 text-[11px] uppercase font-mono tracking-widest text-[#A37F3B] font-bold shadow-sm">
          <span>✨ {{ section.settings.act_tag }}</span>
        </div>
        <h2 class="site-main-title text-[#1E1A17]">
          Objects of <span class="font-zapfino text-[#C2A875] font-normal tracking-normal lowercase inline-block px-1">affection</span>
        </h2>
      </div>

      <p class="max-w-md text-xs sm:text-sm text-[#423C36] leading-relaxed">
        Sculpted bangles with size precision (2.4, 2.6, 2.8), waterproof gold cuffs, and iridescent pearls designed for effortless daily layering.
      </p>
    </div>

    <!-- Product Grid Showcase -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% if collection != blank and collection.products.size > 0 %}
        {% for product in collection.products limit: 4 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="p-4 bg-white rounded-3xl border border-[#D8C39A]/30 space-y-3">
            <div class="aspect-square bg-[#F3ECE1] rounded-2xl flex items-center justify-center text-[#D8C39A]">
              {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover' }}
            </div>
            <h4 class="font-serif text-sm font-bold text-[#1E1A17]">Signature Piece {{ i }}</h4>
            <p class="font-mono text-sm text-[#A37F3B] font-bold">₹150</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</section>
