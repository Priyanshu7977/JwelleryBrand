{% schema %}
{
  "name": "Main Search",
  "settings": []
}
{% endschema %}

<div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
  <div class="text-center space-y-3 max-w-2xl mx-auto border-b border-[#D8C39A]/30 pb-6">
    <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">Catalogue Index</span>
    <h1 class="font-serif text-3xl sm:text-4xl font-bold uppercase text-[#1E1A17]">Search Results</h1>
    
    <form action="{{ routes.search_url }}" method="get" class="pt-2">
      <div class="relative max-w-md mx-auto">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search pieces, bangles, hampers..."
          class="w-full h-12 pl-5 pr-14 rounded-full border border-[#D8C39A]/60 bg-white text-xs font-mono text-[#1E1A17] focus:outline-none focus:border-[#A37F3B]"
        />
        <button type="submit" class="absolute right-2 top-2 bottom-2 px-4 rounded-full bg-[#1E1A17] text-white text-xs font-bold cursor-pointer">
          🔍
        </button>
      </div>
    </form>
  </div>

  {% if search.performed %}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'product-card', product: item %}
        {% endif %}
      {% else %}
        <div class="col-span-full py-16 text-center text-[#786E65] font-serif">
          No creations found for "{{ search.terms }}".
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
