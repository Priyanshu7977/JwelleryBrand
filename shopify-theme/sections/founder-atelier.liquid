{% schema %}
{
  "name": "Act 06 — Founder & Atelier",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 06 — The Soul of Celestia"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From The Mumbai Atelier"
    },
    {
      "type": "textarea",
      "id": "story",
      "label": "Heritage Story",
      "default": "Every Celestia adornment begins as a wax sculpture in our Bandra West studio. We combine medical-grade stainless steel with heavy 18K gold physical vapour deposition so you never have to take off your favourite pieces."
    }
  ],
  "presets": [
    {
      "name": "Act 06 — Founder & Atelier"
    }
  ]
}
{% endschema %}

<section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#FAF7F0] border-b border-[#D8C39A]/30">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Atelier Manifesto -->
    <div class="lg:col-span-7 space-y-6">
      <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
        {{ section.settings.act_tag }}
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-bold uppercase text-[#1E1A17] leading-tight">
        {{ section.settings.heading }}
      </h2>
      <p class="text-sm sm:text-base text-[#423C36] leading-relaxed font-sans">
        {{ section.settings.story }}
      </p>

      <div class="p-5 rounded-2xl bg-[#FAF8F5] border-l-3 border-[#A37F3B] text-xs text-[#1E1A17] italic font-serif">
        "Fine jewellery shouldn't be reserved for vaults or special occasions. It belongs on your skin every single day."
      </div>

      <div class="pt-2">
        <a href="/pages/the-world" class="btn-primary min-h-[48px] h-12 text-xs font-mono uppercase tracking-widest no-underline">
          <span>Read The Celestia Story</span>
          <svg class="w-4 h-4 text-[#D8C39A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>

    <!-- Atelier Studio Badge & Highlights -->
    <div class="lg:col-span-5 bg-white p-6 sm:p-8 rounded-3xl border border-[#D8C39A]/40 shadow-lg space-y-6">
      <h3 class="font-serif text-xl font-bold text-[#1E1A17]">Craftsmanship Pillars</h3>
      <div class="space-y-4 text-xs font-mono">
        <div class="flex items-start gap-3">
          <span class="text-lg">🛡️</span>
          <div>
            <h4 class="font-bold text-[#1E1A17]">Anti-Tarnish 316L Core</h4>
            <p class="text-[#786E65]">Sweatproof, waterproof, and perfume-resistant.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-lg">✨</span>
          <div>
            <h4 class="font-bold text-[#1E1A17]">18K Gold PVD Coating</h4>
            <p class="text-[#786E65]">10x thicker than standard flash electroplating.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-lg">📍</span>
          <div>
            <h4 class="font-bold text-[#1E1A17]">Bandra West Atelier</h4>
            <p class="text-[#786E65]">Hand-packaged & dispatched from Mumbai daily.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
