{% schema %}
{
  "name": "Act 06 — Founder & Atelier",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "The Human Touch • Mumbai Studio Origins"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the atelier"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Founder Quote",
      "default": "I wanted to build a world where jewellery is never intimidating—where every package you receive feels like a warm embrace from a friend."
    },
    {
      "type": "text",
      "id": "location",
      "label": "Studio Location",
      "default": "Bandra West, Mumbai"
    }
  ],
  "presets": [
    {
      "name": "Act 06 — Founder & Atelier"
    }
  ]
}
{% endschema %}

<section class="relative w-full py-16 sm:py-20 md:py-24 px-4 sm:px-6 md:px-10 lg:px-14 bg-[#181411] text-[#FAF7F0] border-t border-[#D8C39A]/30 overflow-hidden selection:bg-[#D8C39A] selection:text-[#181411]">
  <!-- Ambient background radiance -->
  <div class="absolute top-1/4 -left-20 w-[500px] h-[500px] bg-[#D8C39A]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute inset-0 bg-noise opacity-20 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto space-y-10 sm:space-y-12 relative z-10">
    
    <!-- Header -->
    <div class="space-y-3 max-w-4xl border-b border-[#D8C39A]/25 pb-6 sm:pb-8">
      <div class="flex items-center gap-2">
        <span class="text-xs uppercase font-mono tracking-widest text-[#D8C39A] font-bold">
          The Human Touch
        </span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#D8C39A]"></span>
        <span class="text-xs sm:text-sm text-[#FAF7F0]/70 font-medium">
          {{ section.settings.act_tag }}
        </span>
      </div>

      <h2 class="site-main-title text-[#FAF7F0]">
        From the <span class="font-zapfino text-[#D8C39A] font-normal tracking-normal lowercase inline-block px-1">atelier</span>
      </h2>

      <p class="text-base sm:text-xl text-[#FAF7F0]/90 leading-relaxed max-w-2xl font-serif">
        "{{ section.settings.quote }}"
      </p>
    </div>

    <!-- 2-Column Founder Reveal & Personal Narrative -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-center">
      
      <!-- Founder Portrait (5 Cols) -->
      <div class="lg:col-span-5 relative group">
        <div class="aspect-[4/5] max-h-[460px] rounded-3xl overflow-hidden bg-[#251F1B] shadow-2xl border border-[#D8C39A]/40 relative">
          <img
            src="{{ 'celestia-founder.jpg' | asset_url }}"
            alt="Celestia Founder & Head of Atelier"
            class="w-full h-full object-cover filter brightness-[1.02] contrast-[1.02] transition-transform duration-700 group-hover:scale-105"
            style="object-position: center 20%;"
          />
        </div>

        <!-- Founder Atelier Badge -->
        <div class="mt-3 sm:mt-0 sm:absolute sm:-bottom-5 sm:-right-3 p-3.5 sm:p-4 bg-[#251F1B]/95 backdrop-blur-md rounded-2xl shadow-2xl border border-[#D8C39A]/50 max-w-xs space-y-1">
          <div class="flex items-center gap-1.5 text-[#D8C39A] font-mono text-xs uppercase tracking-wider font-bold">
            <span>📍 {{ section.settings.location }}</span>
          </div>
          <p class="text-sm font-bold text-[#FAF7F0]">
            Founder & Head of Atelier
          </p>
          <p class="text-[11px] text-[#FAF7F0]/70">
            Hand-curating pieces, wax seals, and custom polaroids daily.
          </p>
        </div>
      </div>

      <!-- Narrative & Selected Curations (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="space-y-3">
          <h3 class="text-2xl sm:text-3xl text-[#FAF7F0] font-bold leading-snug">
            From a handwritten dream to 1,000+ happy homes across India.
          </h3>
          <p class="text-xs sm:text-sm text-[#FAF7F0]/80 leading-relaxed">
            What started in a small room in Mumbai with a box of pearls, velvet ribbons, and a vintage Polaroid camera has grown into a cherished jewellery sanctuary.
          </p>
          <p class="text-xs sm:text-sm text-[#FAF7F0]/80 leading-relaxed">
            Every piece is cast in medical-grade 316L anti-tarnish steel with heavy 18K gold physical vapour deposition so you can wear your story effortlessly every day.
          </p>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a
            href="/pages/the-world"
            class="btn-primary min-h-[48px] h-12 px-7 rounded-full bg-[#D8C39A] hover:bg-[#E5D2AD] text-[#181411] text-xs uppercase tracking-widest font-bold active:scale-[0.98] transition-all inline-flex items-center justify-center gap-2 shadow-lg no-underline"
          >
            <span>Discover The Full Story</span>
            <svg class="w-4 h-4 text-[#181411]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <a
            href="{{ settings.social_instagram_link | default: 'https://instagram.com/celestiaamor.in' }}"
            target="_blank"
            class="min-h-[48px] h-12 px-7 rounded-full border border-[#D8C39A]/40 hover:bg-[#D8C39A]/15 text-[#FAF7F0] text-xs uppercase tracking-widest font-bold active:scale-[0.98] transition-all inline-flex items-center justify-center gap-2 no-underline"
          >
            <span>@celestiaamor.in</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
