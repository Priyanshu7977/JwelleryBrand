{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Products Per Page"
    }
  ]
}
{% endschema %}

{% paginate collection.products by section.settings.products_per_page %}
  <div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    
    <!-- Collection Header -->
    <div class="text-center space-y-3 max-w-3xl mx-auto border-b border-[#D8C39A]/30 pb-8">
      <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
        Curated Catalogue
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold uppercase text-[#1E1A17]">
        {{ collection.title }}
      </h1>
      {% if collection.description != blank %}
        <p class="text-xs sm:text-sm text-[#423C36] leading-relaxed">
          {{ collection.description }}
        </p>
      {% endif %}
    </div>

    <!-- Collection Products Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <div class="col-span-full py-16 text-center text-[#786E65] font-serif">
          No creations found in this collection.
        </div>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <div class="flex items-center justify-center gap-2 pt-8">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}

  </div>
{% endpaginate %}
