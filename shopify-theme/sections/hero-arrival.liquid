{% schema %}
{
  "name": "Act 01 — Hero Arrival",
  "settings": [
    {
      "type": "text",
      "id": "act_title",
      "label": "Act Tag",
      "default": "Act 01 — The Arrival"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Headline",
      "default": "Sculpted in Gold & Light"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "18K Gold PVD Anti-Tarnish Fine Jewellery, Sculpted Cuffs & Bespoke Polaroid Gifting Hampers."
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Text",
      "default": "Explore The Collections"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image Banner"
    }
  ],
  "presets": [
    {
      "name": "Act 01 — Hero Arrival"
    }
  ]
}
{% endschema %}

<section class="relative min-h-[90vh] flex items-center justify-center bg-[#181411] text-[#FAF7F0] px-4 sm:px-6 py-20 overflow-hidden">
  <!-- Background Glow & Media -->
  <div class="absolute inset-0 bg-noise opacity-20 pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#D8C39A]/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-5xl mx-auto text-center space-y-8">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#28231F] border border-[#D8C39A]/40 text-xs uppercase font-mono tracking-widest text-[#D8C39A]">
      <span>✨ {{ section.settings.act_title }}</span>
    </div>

    <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-bold uppercase tracking-tight text-[#FAF7F0] leading-tight">
      {{ section.settings.heading }}
    </h1>

    <p class="font-sans text-sm sm:text-base text-[#EDE6DA]/80 max-w-2xl mx-auto leading-relaxed">
      {{ section.settings.subheading }}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a
        href="{{ section.settings.primary_cta_link | default: '/collections/all' }}"
        class="btn-primary w-full sm:w-auto min-h-[48px] h-12 px-8 text-xs font-mono uppercase tracking-widest"
      >
        <span>{{ section.settings.primary_cta_text }}</span>
        <svg class="w-4 h-4 text-[#D8C39A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <a
        href="https://wa.me/{{ settings.whatsapp_number | default: '917718825792' }}"
        target="_blank"
        class="btn-secondary w-full sm:w-auto min-h-[48px] h-12 px-8 text-xs font-mono uppercase tracking-widest bg-transparent border-[#D8C39A]/50 text-[#FAF7F0] hover:bg-[#D8C39A]/10 hover:text-white"
      >
        <span>Atelier WhatsApp Concierge</span>
      </a>
    </div>

    <!-- Mumbai Studio Proof Bar -->
    <div class="pt-8 border-t border-[#D8C39A]/20 flex flex-wrap items-center justify-center gap-6 text-[11px] font-mono text-[#D8C39A]">
      <span>💎 100% Anti-Tarnish Guarantee</span>
      <span>•</span>
      <span>⚡ Same-Day Mumbai Express</span>
      <span>•</span>
      <span>📦 Free Pan-India Shipping</span>
    </div>
  </div>
</section>
