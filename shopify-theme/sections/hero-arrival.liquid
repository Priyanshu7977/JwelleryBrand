{% schema %}
{
  "name": "Act 01 — The Arrival",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "Handcrafted"
    },
    {
      "type": "text",
      "id": "heading_script",
      "label": "Heading Script Word",
      "default": "fine jewellery"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "redefined for all"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover artisanal bangles, 18k gold dipped jewellery suites, and custom celebration gift hampers handcrafted with love in Mumbai."
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Gift Hampers"
    }
  ],
  "presets": [
    {
      "name": "Act 01 — The Arrival"
    }
  ]
}
{% endschema %}

<section
  id="section-arrival"
  class="relative w-full h-[100dvh] min-h-[580px] max-h-[1080px] bg-black selection:bg-[#D8C39A]/40 flex flex-col justify-end pb-10 sm:pb-14 md:pb-16 px-4 sm:px-6 md:px-10 lg:px-14 overflow-hidden"
>
  <!-- 100% PURE, FULL-SCREEN AUTOPLAYING JEWELLERY BACKGROUND VIDEO -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none z-0">
    <video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover object-center scale-100 opacity-90 transition-opacity duration-500"
    >
      <source src="{{ 'hero-jewelry.mp4' | asset_url }}" type="video/mp4" />
      <source src="{{ 'hero-jewelry.webm' | asset_url }}" type="video/webm" />
      <source src="https://upload.wikimedia.org/wikipedia/commons/4/47/Jewellery_Maker.webm" type="video/webm" />
    </video>

    <!-- High-contrast dark gradient overlay for crystal-clear text visibility -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/55 to-black/35"></div>
  </div>

  <!-- HIGH-CONTRAST WHITE TEXT & 2 ACTION BUTTONS -->
  <div class="relative z-10 w-full max-w-7xl mx-auto space-y-4">
    
    <!-- Headline & Description -->
    <div class="max-w-xl lg:max-w-2xl space-y-3 text-left">
      <h1 class="site-main-title text-white drop-shadow-2xl">
        {{ section.settings.heading_line1 }} <br />
        <span class="font-zapfino text-[#D8C39A] font-normal tracking-normal lowercase inline-block py-2.5 drop-shadow-2xl">
          {{ section.settings.heading_script }}
        </span> <br />
        {{ section.settings.heading_line2 }}
      </h1>

      <p class="text-xs sm:text-base md:text-lg text-white font-medium max-w-xl leading-relaxed drop-shadow-lg">
        {{ section.settings.subheading }}
      </p>
    </div>

    <!-- 2 Floating Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-start gap-3.5 pt-2">
      <!-- Button 1: Explore Collection -->
      <a
        href="{{ section.settings.btn1_link | default: '/collections/all' }}"
        class="w-full sm:w-auto px-8 sm:px-10 py-3.5 sm:py-4 rounded-full bg-white hover:bg-[#FAF8F5] text-[#1E1A17] text-xs sm:text-sm uppercase font-mono tracking-widest font-bold shadow-2xl hover:scale-105 active:scale-[0.98] transition-all flex items-center justify-center gap-2.5 border border-white no-underline"
      >
        <span>{{ section.settings.btn1_text }}</span>
        <svg class="w-4 h-4 text-[#1E1A17]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <!-- Button 2: Custom Gift Hampers -->
      <a
        href="{{ section.settings.btn2_link | default: '/pages/gifting' }}"
        class="w-full sm:w-auto px-8 sm:px-10 py-3.5 sm:py-4 rounded-full bg-black/60 hover:bg-black/80 text-white text-xs sm:text-sm uppercase font-mono tracking-widest font-bold shadow-2xl hover:scale-105 active:scale-[0.98] transition-all flex items-center justify-center gap-2.5 backdrop-blur-md border border-white/60 no-underline"
      >
        <span>{{ section.settings.btn2_text }}</span>
        <svg class="w-4 h-4 text-[#D8C39A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm0 0H4m8 0h8M4 13h16M4 18h16"/></svg>
      </a>
    </div>

  </div>
</section>
