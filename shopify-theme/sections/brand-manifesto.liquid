{% schema %}
{
  "name": "Act 08 — Atelier Finale",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 08 — The Atelier Finale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Redefined for all"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find something that feels like you."
    },
    {
      "type": "textarea",
      "id": "manifesto",
      "label": "Manifesto Text",
      "default": "From subtle everyday chains to grand celebration hampers, every piece is curated to capture your moments in gold."
    }
  ],
  "presets": [
    {
      "name": "Act 08 — Atelier Finale"
    }
  ]
}
{% endschema %}

<section class="relative w-full py-20 md:py-28 px-4 sm:px-6 md:px-12 lg:px-20 bg-[#FAF7F0] overflow-hidden text-center border-t border-[#D8C39A]/40">
  <!-- Soft Ambient Radiance -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#D8C39A]/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute inset-0 bg-noise opacity-30 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto space-y-8 sm:space-y-10 relative z-10">
    
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#FAF8F5] border border-[#D8C39A]/60 text-[11px] uppercase tracking-widest text-[#A37F3B] font-bold shadow-sm">
      <span>✨ {{ section.settings.act_tag }}</span>
    </div>

    <!-- Large Typography Transition -->
    <div class="space-y-3">
      <h2 class="site-main-title text-[#1E1A17]">
        Redefined <br />
        <span class="font-zapfino text-[#C2A875] font-normal tracking-normal lowercase inline-block px-1">for all</span>
      </h2>

      <p class="text-xl sm:text-2xl md:text-3xl text-[#1E1A17]/85 font-serif max-w-xl mx-auto pt-2 font-bold">
        {{ section.settings.subheading }}
      </p>
    </div>

    <p class="max-w-md mx-auto text-xs sm:text-sm text-[#423C36] leading-relaxed">
      {{ section.settings.manifesto }}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-3 max-w-md sm:max-w-none mx-auto w-full">
      <a
        href="/collections/all"
        class="btn-primary w-full sm:w-auto min-h-[48px] h-12 sm:h-14 px-8 text-xs uppercase font-mono tracking-widest no-underline"
      >
        <span>Explore Celestia Collections</span>
      </a>

      <button
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        class="w-full sm:w-auto min-h-[48px] h-12 sm:h-14 px-8 rounded-full border border-[#D8C39A]/80 bg-white hover:bg-[#FAF8F5] active:scale-[0.98] text-[#1E1A17] text-xs uppercase font-mono tracking-widest font-bold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs"
      >
        <span>Back to Top ↑</span>
      </button>
    </div>

  </div>
</section>
