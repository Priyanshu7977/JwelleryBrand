{% schema %}
{
  "name": "Act 09 — Final Manifesto",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Collection"
    },
    {
      "type": "textarea",
      "id": "manifesto",
      "label": "Manifesto Text",
      "default": "Every piece is an invitation to wear your world with quiet confidence."
    }
  ],
  "presets": [
    {
      "name": "Act 09 — Final Manifesto"
    }
  ]
}
{% endschema %}

<section class="py-24 sm:py-32 px-4 sm:px-6 lg:px-8 bg-[#181411] text-[#FAF7F0] text-center relative overflow-hidden">
  <div class="absolute inset-0 bg-noise opacity-20 pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#D8C39A]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-4xl mx-auto space-y-8">
    <span class="text-xs uppercase font-mono tracking-widest text-[#D8C39A] font-bold block">
      ✨ Act 09 — Redefined For All
    </span>

    <h2 class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold uppercase text-[#FAF7F0] leading-tight">
      {{ section.settings.heading }}
    </h2>

    <p class="font-sans text-sm sm:text-lg text-[#EDE6DA]/80 max-w-2xl mx-auto leading-relaxed italic">
      "{{ section.settings.manifesto }}"
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/collections/all"
        class="btn-primary min-h-[48px] h-12 px-8 text-xs font-mono uppercase tracking-widest bg-[#D8C39A] text-[#181411] hover:bg-[#E5D2AD] no-underline"
      >
        <span>Explore All Pieces</span>
        <svg class="w-4 h-4 text-[#181411]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <button
        type="button"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        class="btn-secondary min-h-[48px] h-12 px-6 text-xs font-mono uppercase tracking-widest bg-transparent text-[#FAF7F0] border-[#D8C39A]/40 hover:bg-[#D8C39A]/10 cursor-pointer"
      >
        <span>Back To Top ↑</span>
      </button>
    </div>
  </div>
</section>
