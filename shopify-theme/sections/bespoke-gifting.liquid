{% schema %}
{
  "name": "Act 05 — Bespoke Gifting",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 05 — The Gifting Atelier"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For someone special"
    },
    {
      "type": "product",
      "id": "hamper_product",
      "label": "Base Hamper Product"
    }
  ],
  "presets": [
    {
      "name": "Act 05 — Bespoke Gifting"
    }
  ]
}
{% endschema %}

{% assign product = all_products[section.settings.hamper_product] %}

<section
  id="section-gifting"
  class="relative w-full py-16 sm:py-20 md:py-24 px-4 sm:px-6 md:px-10 lg:px-14 bg-[#FBF6F3] overflow-hidden border-t border-[#D8C39A]/30"
>
  <!-- Soft Ambient Glow -->
  <div class="absolute top-10 left-1/3 w-[500px] h-[500px] bg-[#F7EDE7] rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[400px] h-[400px] bg-[#D8C39A]/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto space-y-10 sm:space-y-12">
    
    <!-- Section Header -->
    <div class="text-center space-y-3 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#FAF8F5] border border-[#EADCD5] text-[11px] uppercase font-mono tracking-widest text-[#A37F3B] font-bold shadow-sm">
        <span>🎁 {{ section.settings.act_tag }}</span>
      </div>

      <h2 class="site-main-title text-[#1E1A17]">
        For someone <span class="font-zapfino text-[#C2A875] font-normal tracking-normal lowercase inline-block px-1">special</span>
      </h2>

      <p class="text-xs sm:text-sm text-[#423C36] leading-relaxed">
        Craft a custom celebration gift box. Select your keepsake velvet packaging, choose signature adornments, and include a personalized printed retro Polaroid.
      </p>
    </div>

    <!-- 2-Column Workshop Studio -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 items-start">
      
      <!-- Left Column: Hamper Builder Controls (7 Cols) -->
      <div class="lg:col-span-7 space-y-6 bg-white/90 p-5 sm:p-8 rounded-3xl border border-[#D8C39A]/60 shadow-luxury-soft">
        
        <!-- Step 1: Select Box Casing -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-xs uppercase font-mono tracking-widest text-[#1E1A17] font-bold flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[#1E1A17] text-[#FAF7F0] flex items-center justify-center text-[10px] font-mono">1</span>
              Select Keepsake Velvet Box
            </h4>
            <span class="text-xs font-mono text-[#A37F3B] font-bold">{% if product != blank %}{{ product.price | money }}{% else %}₹150{% endif %}</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="p-3.5 rounded-2xl border border-[#A37F3B] bg-[#F6EDE0]/60 shadow-md ring-2 ring-[#A37F3B]/30 text-left">
              <div class="aspect-[4/3] rounded-xl overflow-hidden mb-2 bg-[#F3ECE1]">
                <img src="{{ 'desi-barbie-hamper.jpg' | asset_url }}" alt="Desi Barbie Hamper" class="w-full h-full object-cover" />
              </div>
              <p class="text-xs font-bold text-[#1E1A17]">Royal Velvet Box</p>
              <p class="text-[11px] text-[#A37F3B] font-mono font-bold mt-0.5">₹150</p>
            </div>
            <div class="p-3.5 rounded-2xl border border-[#D8C39A]/60 bg-[#FAF8F5] text-left">
              <div class="aspect-[4/3] rounded-xl overflow-hidden mb-2 bg-[#F3ECE1]">
                <img src="{{ 'purple-tulip-hamper.jpg' | asset_url }}" alt="Purple Tulip Hamper" class="w-full h-full object-cover" />
              </div>
              <p class="text-xs font-bold text-[#1E1A17]">Botanical Box</p>
              <p class="text-[11px] text-[#A37F3B] font-mono font-bold mt-0.5">₹150</p>
            </div>
            <div class="p-3.5 rounded-2xl border border-[#D8C39A]/60 bg-[#FAF8F5] text-left">
              <div class="aspect-[4/3] rounded-xl overflow-hidden mb-2 bg-[#F3ECE1]">
                <img src="{{ 'polaroids-20.jpg' | asset_url }}" alt="Polaroid Memory Box" class="w-full h-full object-cover" />
              </div>
              <p class="text-xs font-bold text-[#1E1A17]">Memory Hamper</p>
              <p class="text-[11px] text-[#A37F3B] font-mono font-bold mt-0.5">₹150</p>
            </div>
          </div>
        </div>

        <!-- Step 2: Personalised Note & Polaroid -->
        <form method="post" action="/cart/add" enctype="multipart/form-data" class="space-y-4 pt-4 border-t border-[#D8C39A]/50">
          {% if product != blank %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
          {% endif %}

          <div class="space-y-2">
            <h4 class="text-xs uppercase font-mono tracking-widest text-[#1E1A17] font-bold flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[#1E1A17] text-[#FAF7F0] flex items-center justify-center text-[10px] font-mono">2</span>
              Handwritten Note & Custom Polaroid
            </h4>
            {% render 'polaroid-customizer' %}
          </div>

          <!-- Step 3: Add to Bag Action -->
          <div class="pt-2">
            <button
              type="submit"
              class="btn-primary w-full min-h-[48px] h-12 flex items-center justify-center gap-2 text-xs uppercase font-bold tracking-widest shadow-lg hover:shadow-xl active:scale-[0.98] transition-all cursor-pointer"
            >
              <span>✨ Add Custom Hamper to Bag • {% if product != blank %}{{ product.price | money }}{% else %}₹150{% endif %}</span>
            </button>
          </div>
        </form>

      </div>

      <!-- Right Column: Live Hamper Preview (5 Cols) -->
      <div class="lg:col-span-5 bg-white/95 p-5 sm:p-7 rounded-3xl border border-[#D8C39A]/60 shadow-luxury-soft space-y-4">
        <div class="flex items-center justify-between border-b border-[#D8C39A]/40 pb-3">
          <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
            Live Hamper Assembly
          </span>
          <span class="text-[10px] font-mono text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full font-bold">
            Mumbai Atelier
          </span>
        </div>

        <div class="space-y-3 text-xs font-mono text-[#1E1A17]">
          <div class="flex items-center gap-2"><span>📦</span> <span>Handcrafted Velvet Keepsake Case</span></div>
          <div class="flex items-center gap-2"><span>📸</span> <span>Fujifilm Retro Polaroid Photo Insert</span></div>
          <div class="flex items-center gap-2"><span>💌</span> <span>Wax-Sealed Calligraphy Note</span></div>
          <div class="flex items-center gap-2"><span>🌹</span> <span>Scented Botanical Flora & Satin Ribbons</span></div>
        </div>

        <div class="pt-2">
          <a
            href="https://wa.me/{{ settings.whatsapp_number | default: '917718825792' }}?text=Hi%20Celestia%20Atelier,%20I%20would%20like%20to%20customise%20a%20Bespoke%20Hamper."
            target="_blank"
            class="w-full min-h-[44px] h-11 rounded-full border border-emerald-600/60 bg-emerald-50 text-emerald-950 text-xs uppercase font-mono tracking-wider font-bold transition-all flex items-center justify-center gap-2 no-underline"
          >
            <span>WhatsApp Bespoke Stylist</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
