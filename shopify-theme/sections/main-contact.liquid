{% schema %}
{
  "name": "Main Contact",
  "settings": []
}
{% endschema %}

<div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-10">
  <div class="text-center space-y-2 border-b border-[#D8C39A]/30 pb-6">
    <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">Mumbai Atelier Desk</span>
    <h1 class="font-serif text-3xl sm:text-5xl font-bold uppercase text-[#1E1A17]">Contact Us</h1>
    <p class="text-xs text-[#786E65]">Have questions about bespoke sizing or express Mumbai deliveries? Reach out below.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
    <!-- Contact Form -->
    <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#D8C39A]/40 shadow-sm space-y-4">
      <h3 class="font-serif text-xl font-bold text-[#1E1A17]">Send a Direct Message</h3>
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div class="p-4 bg-emerald-50 text-emerald-800 rounded-xl text-xs font-mono font-bold">
            ✨ Message received. Our atelier concierge will reply shortly.
          </div>
        {% endif %}

        <div class="space-y-3">
          <div>
            <label class="block text-xs font-mono uppercase text-[#1E1A17] font-bold mb-1">Your Name</label>
            <input type="text" name="contact[name]" required class="w-full h-11 px-4 rounded-xl border border-[#D8C39A]/50 text-xs focus:outline-none focus:border-[#A37F3B]" />
          </div>
          <div>
            <label class="block text-xs font-mono uppercase text-[#1E1A17] font-bold mb-1">Email Address</label>
            <input type="email" name="contact[email]" required class="w-full h-11 px-4 rounded-xl border border-[#D8C39A]/50 text-xs focus:outline-none focus:border-[#A37F3B]" />
          </div>
          <div>
            <label class="block text-xs font-mono uppercase text-[#1E1A17] font-bold mb-1">Message</label>
            <textarea name="contact[body]" rows="4" required class="w-full p-4 rounded-xl border border-[#D8C39A]/50 text-xs focus:outline-none focus:border-[#A37F3B]"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full min-h-[48px] h-12 text-xs uppercase font-mono tracking-widest font-bold cursor-pointer">
            Send Message
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Atelier Physical Coordinates & WhatsApp -->
    <div class="space-y-6 bg-[#FAF8F5] p-6 sm:p-8 rounded-3xl border border-[#D8C39A]/40">
      <div class="space-y-2">
        <h3 class="font-serif text-xl font-bold text-[#1E1A17]">The Physical Atelier</h3>
        <p class="text-xs text-[#786E65] font-mono leading-relaxed">
          {{ settings.studio_address | default: 'Bandra West Atelier • Mumbai 400050' }}
        </p>
      </div>

      <div class="space-y-3 pt-2">
        <a
          href="https://wa.me/{{ settings.whatsapp_number | default: '917718825792' }}"
          target="_blank"
          class="w-full min-h-[48px] h-12 rounded-full bg-emerald-800 hover:bg-emerald-900 text-white text-xs uppercase font-mono tracking-wider font-bold transition-all flex items-center justify-center gap-2 no-underline"
        >
          <span>Chat on WhatsApp (+91 7718825792)</span>
        </a>

        <a
          href="https://instagram.com/celestiaamor.in"
          target="_blank"
          class="btn-secondary w-full min-h-[48px] h-12 text-xs uppercase font-mono tracking-wider font-bold no-underline"
        >
          <span>Instagram @celestiaamor.in</span>
        </a>
      </div>
    </div>
  </div>
</div>
