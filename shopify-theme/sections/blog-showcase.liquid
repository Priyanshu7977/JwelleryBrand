{% schema %}
{
  "name": "Act 08 — Editorial Journal",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 08 — From the Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories & Lookbooks"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Featured Blog"
    }
  ],
  "presets": [
    {
      "name": "Act 08 — Editorial Journal"
    }
  ]
}
{% endschema %}

{% assign blog = blogs[section.settings.blog] %}

<section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#FAF7F0] border-b border-[#D8C39A]/30">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[#D8C39A]/30 pb-6">
      <div class="space-y-1">
        <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
          {{ section.settings.act_tag }}
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl font-bold uppercase text-[#1E1A17]">
          {{ section.settings.heading }}
        </h2>
      </div>
      <a href="{{ blog.url | default: '/blogs/journal' }}" class="text-xs uppercase font-mono tracking-widest text-[#1E1A17] hover:text-[#A37F3B] font-bold flex items-center gap-1.5 no-underline">
        <span>Read All Articles</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {% if blog != blank and blog.articles.size > 0 %}
        {% for article in blog.articles limit: 3 %}
          <div class="bg-white rounded-3xl p-5 border border-[#D8C39A]/40 shadow-sm hover:shadow-lg transition-all space-y-3">
            {% if article.image %}
              <div class="aspect-[16/10] rounded-2xl overflow-hidden bg-[#F3ECE1]">
                <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}" class="w-full h-full object-cover" />
              </div>
            {% endif %}
            <span class="text-[10px] font-mono uppercase tracking-widest text-[#A37F3B] font-bold block">{{ article.published_at | date: "%B %d, %Y" }}</span>
            <h3 class="font-serif text-lg font-bold text-[#1E1A17] hover:text-[#A37F3B] transition-colors">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>
            <p class="text-xs text-[#786E65] line-clamp-2">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="bg-white rounded-3xl p-6 border border-[#D8C39A]/40 space-y-3">
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#A37F3B] font-bold block">Styling Guide</span>
          <h3 class="font-serif text-lg font-bold text-[#1E1A17]">How to Layer 18K Anti-Tarnish Cuffs</h3>
          <p class="text-xs text-[#786E65]">The Mumbai stylist guide to effortless everyday stacking.</p>
        </div>
        <div class="bg-white rounded-3xl p-6 border border-[#D8C39A]/40 space-y-3">
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#A37F3B] font-bold block">Behind The Scenes</span>
          <h3 class="font-serif text-lg font-bold text-[#1E1A17]">The Art of Wax-Sealed Gifting</h3>
          <p class="text-xs text-[#786E65]">Why instant Fujifilm polaroids make the ultimate keepsake.</p>
        </div>
        <div class="bg-white rounded-3xl p-6 border border-[#D8C39A]/40 space-y-3">
          <span class="text-[10px] font-mono uppercase tracking-widest text-[#A37F3B] font-bold block">Care Guide</span>
          <h3 class="font-serif text-lg font-bold text-[#1E1A17]">Anti-Tarnish Science Explained</h3>
          <p class="text-xs text-[#786E65]">PVD titanium vs. flash electroplating: what you need to know.</p>
        </div>
      {% endif %}
    </div>

  </div>
</section>
