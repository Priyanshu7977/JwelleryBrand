{% schema %}
{
  "name": "Act 06 — Authentic Trust",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 06 — Authentic Trust"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Praised by those who wear it"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 Number",
      "default": "1,000+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Orders Dispatched"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 Number",
      "default": "4.95/5"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Client Satisfaction"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 Number",
      "default": "Mumbai"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Same-Day Express Courier"
    },
    {
      "type": "text",
      "id": "stat_4_number",
      "label": "Stat 4 Number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_4_label",
      "label": "Stat 4 Label",
      "default": "Anti-Tarnish Seal"
    }
  ],
  "presets": [
    {
      "name": "Act 06 — Authentic Trust"
    }
  ]
}
{% endschema %}

<section
  id="section-community"
  class="relative w-full py-20 sm:py-28 md:py-36 px-4 sm:px-6 md:px-10 lg:px-14 bg-[#FDFBF7] overflow-hidden border-t border-[#D8C39A]/30"
>
  <!-- Background Ambience -->
  <div class="absolute inset-0 bg-noise opacity-30 pointer-events-none"></div>
  <div class="absolute top-1/3 left-10 w-96 h-96 bg-[#D8C39A]/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- Top Verified Metric Band -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 py-8 px-6 sm:px-8 rounded-3xl bg-[#FAF8F5]/90 border border-[#D8C39A]/50 shadow-luxury-soft divide-y md:divide-y-0 md:divide-x divide-[#D8C39A]/40 text-center">
      
      <div class="space-y-1 py-3 md:py-0">
        <span class="font-serif text-4xl sm:text-5xl text-[#1E1A17] font-bold">
          {{ section.settings.stat_1_number }}
        </span>
        <p class="text-[11px] uppercase tracking-widest text-[#786E65] font-sans">
          {{ section.settings.stat_1_label }}
        </p>
      </div>

      <div class="space-y-1 py-3 md:py-0">
        <span class="font-serif text-4xl sm:text-5xl text-[#1E1A17] font-bold">
          {{ section.settings.stat_2_number }}
        </span>
        <p class="text-[11px] uppercase tracking-widest text-[#786E65] font-sans">
          {{ section.settings.stat_2_label }}
        </p>
      </div>

      <div class="space-y-1 py-3 md:py-0">
        <span class="font-serif text-4xl sm:text-5xl text-[#1E1A17] font-bold">
          {{ section.settings.stat_3_number }}
        </span>
        <p class="text-[11px] uppercase tracking-widest text-[#786E65] font-sans">
          {{ section.settings.stat_3_label }}
        </p>
      </div>

      <div class="space-y-1 py-3 md:py-0">
        <span class="font-serif text-4xl sm:text-5xl text-[#1E1A17] font-bold">
          {{ section.settings.stat_4_number }}
        </span>
        <p class="text-[11px] uppercase tracking-widest text-[#786E65] font-sans">
          {{ section.settings.stat_4_label }}
        </p>
      </div>

    </div>

    <!-- Section Headline -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[#D8C39A]/40 pb-6 sm:pb-8">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="text-[11px] uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
            {{ section.settings.act_tag }}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#A37F3B]"></span>
          <span class="text-xs text-[#786E65] font-mono">Verified Atelier Reviews 🧿✨</span>
        </div>
        <h2 class="site-main-title text-[#1E1A17]">
          Praised by <span class="font-zapfino text-[#C2A875] font-normal tracking-normal lowercase inline-block px-1">those who wear it</span>
        </h2>
      </div>

      <p class="max-w-md text-xs md:text-sm text-[#423C36] leading-relaxed">
        Real experiences from verified clients across Mumbai, Delhi, Bengaluru, and Pan-India.
      </p>
    </div>

    <!-- Editorial Customer Review Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="p-6 rounded-3xl bg-[#FAF8F5] border border-[#D8C39A]/40 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="flex items-center justify-between text-[#A37F3B]">
            <span>★★★★★</span>
            <span class="text-[10px] font-mono text-[#786E65]">2 days ago</span>
          </div>
          <blockquote class="font-serif text-sm text-[#1E1A17] leading-relaxed">
            "The packaging alone made me gasp! The Polaroid keepsake and handwritten note felt so intimate and royal."
          </blockquote>
        </div>
        <div class="pt-3 border-t border-[#D8C39A]/30">
          <p class="font-serif text-sm font-bold text-[#1E1A17]">Aanya Sharma</p>
          <p class="text-[11px] text-[#786E65]">Bandra, Mumbai • Verified Buyer</p>
        </div>
      </div>

      <div class="p-6 rounded-3xl bg-[#FAF8F5] border border-[#D8C39A]/40 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="flex items-center justify-between text-[#A37F3B]">
            <span>★★★★★</span>
            <span class="text-[10px] font-mono text-[#786E65]">5 days ago</span>
          </div>
          <blockquote class="font-serif text-sm text-[#1E1A17] leading-relaxed">
            "Wore the gold wave bangles to a beach wedding and they still shine brilliantly without any tarnishing."
          </blockquote>
        </div>
        <div class="pt-3 border-t border-[#D8C39A]/30">
          <p class="font-serif text-sm font-bold text-[#1E1A17]">Rhea Merchant</p>
          <p class="text-[11px] text-[#786E65]">South Delhi • Verified Buyer</p>
        </div>
      </div>

      <div class="p-6 rounded-3xl bg-[#FAF8F5] border border-[#D8C39A]/40 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="flex items-center justify-between text-[#A37F3B]">
            <span>★★★★★</span>
            <span class="text-[10px] font-mono text-[#786E65]">1 week ago</span>
          </div>
          <blockquote class="font-serif text-sm text-[#1E1A17] leading-relaxed">
            "The same-day delivery in Mumbai saved my anniversary! Ordered at 11 AM and had it at my doorstep by 4 PM."
          </blockquote>
        </div>
        <div class="pt-3 border-t border-[#D8C39A]/30">
          <p class="font-serif text-sm font-bold text-[#1E1A17]">Kabir & Tanvi</p>
          <p class="text-[11px] text-[#786E65]">Juhu, Mumbai • Verified Buyer</p>
        </div>
      </div>

      <div class="p-6 rounded-3xl bg-[#FAF8F5] border border-[#D8C39A]/40 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="flex items-center justify-between text-[#A37F3B]">
            <span>★★★★★</span>
            <span class="text-[10px] font-mono text-[#786E65]">2 weeks ago</span>
          </div>
          <blockquote class="font-serif text-sm text-[#1E1A17] leading-relaxed">
            "Every detail from the emerald velvet box to the anti-tarnish shine is pure luxury at an accessible price point."
          </blockquote>
        </div>
        <div class="pt-3 border-t border-[#D8C39A]/30">
          <p class="font-serif text-sm font-bold text-[#1E1A17]">Pooja Kapoor</p>
          <p class="text-[11px] text-[#786E65]">Bengaluru • Verified Buyer</p>
        </div>
      </div>

    </div>

  </div>
</section>
