{% schema %}
{
  "name": "Act 03 — Curated Realms",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 03 — Curated Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Celestia Constellation"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection to Display"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Products to Show"
    }
  ],
  "presets": [
    {
      "name": "Act 03 — Curated Realms"
    }
  ]
}
{% endschema %}

{% assign collection = collections[section.settings.featured_collection] %}

<section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#FAF8F5] border-b border-[#D8C39A]/30">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[#D8C39A]/30 pb-6">
      <div class="space-y-1">
        <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
          {{ section.settings.act_tag }}
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl font-bold uppercase text-[#1E1A17]">
          {{ section.settings.heading }}
        </h2>
      </div>
      <a href="{{ collection.url | default: '/collections/all' }}" class="text-xs uppercase font-mono tracking-widest text-[#1E1A17] hover:text-[#A37F3B] font-bold flex items-center gap-1.5 no-underline">
        <span>View Full Catalogue</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% if collection != blank and collection.products.size > 0 %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="p-4 bg-white rounded-3xl border border-[#D8C39A]/30 space-y-3">
            <div class="aspect-square bg-[#F3ECE1] rounded-2xl flex items-center justify-center text-[#D8C39A]">
              {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover' }}
            </div>
            <h4 class="font-serif text-sm font-bold text-[#1E1A17]">Curated Piece {{ i }}</h4>
            <p class="font-mono text-sm text-[#A37F3B] font-bold">₹150</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</section>
