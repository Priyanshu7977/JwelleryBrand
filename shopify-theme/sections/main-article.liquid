{% schema %}
{
  "name": "Main Article",
  "settings": []
}
{% endschema %}

<article class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-8">
  <div class="text-center space-y-3 border-b border-[#D8C39A]/30 pb-6">
    <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">{{ article.published_at | date: "%B %d, %Y" }}</span>
    <h1 class="font-serif text-3xl sm:text-5xl font-bold uppercase text-[#1E1A17] leading-tight">{{ article.title }}</h1>
  </div>

  {% if article.image %}
    <div class="aspect-[16/9] rounded-3xl overflow-hidden bg-[#F3ECE1] border border-[#D8C39A]/40 shadow-lg">
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title }}" class="w-full h-full object-cover" />
    </div>
  {% endif %}

  <div class="prose max-w-none text-sm text-[#423C36] leading-relaxed font-sans space-y-4">
    {{ article.content }}
  </div>

  <div class="pt-8 border-t border-[#D8C39A]/30 flex justify-between items-center">
    <a href="{{ blog.url }}" class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] hover:underline font-bold">
      ← Back to {{ blog.title }}
    </a>
  </div>
</article>
