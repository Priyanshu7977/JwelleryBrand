{% schema %}
{
  "name": "Act 02 — The Reveal",
  "settings": [
    {
      "type": "text",
      "id": "act_subtitle",
      "label": "Act Subtitle",
      "default": "Act 02 — The Reveal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sculpted in Gold & Light"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured Suite Piece"
    }
  ],
  "presets": [
    {
      "name": "Act 02 — The Reveal"
    }
  ]
}
{% endschema %}

{% assign product = all_products[section.settings.featured_product] %}

<section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#FAF7F0] border-b border-[#D8C39A]/30">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Editorial Heading -->
    <div class="text-center space-y-2 max-w-3xl mx-auto">
      <span class="text-xs uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
        {{ section.settings.act_subtitle }}
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-bold uppercase text-[#1E1A17]">
        {{ section.settings.heading }}
      </h2>
    </div>

    <!-- Product Editorial Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center bg-white rounded-3xl p-6 sm:p-10 border border-[#D8C39A]/40 shadow-xl">
      <!-- Media Gallery -->
      <div class="lg:col-span-6 relative aspect-square rounded-2xl overflow-hidden bg-[#F3ECE1]">
        {% if product != blank and product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 1000 }}"
            alt="{{ product.title | escape }}"
            class="w-full h-full object-cover"
          />
        {% else %}
          <div class="w-full h-full flex items-center justify-center text-[#D8C39A]">
            {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
          </div>
        {% endif %}
        <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-[#1E1A17] text-[#FAF7F0] text-xs font-mono font-bold uppercase">
          18K Gold PVD • Anti-Tarnish
        </span>
      </div>

      <!-- Suite Details & Actions -->
      <div class="lg:col-span-6 space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono uppercase tracking-widest text-[#A37F3B] font-bold">
            {% if product != blank %}{{ product.type | default: 'Signature Suite' }}{% else %}Atelier Masterpiece{% endif %}
          </span>
          <h3 class="font-serif text-2xl sm:text-4xl font-bold text-[#1E1A17]">
            {% if product != blank %}{{ product.title }}{% else %}Baroque Pearl & Gold Sculpted Suite{% endif %}
          </h3>
          <p class="font-mono text-2xl text-[#A37F3B] font-bold">
            {% if product != blank %}{{ product.price | money }}{% else %}₹150{% endif %}
          </p>
        </div>

        <p class="text-xs sm:text-sm text-[#423C36] leading-relaxed font-sans">
          {% if product != blank and product.description != blank %}
            {{ product.description | truncatewords: 40 }}
          {% else %}
            Cast in medical-grade 316L stainless steel with heavy 18K gold physical vapour deposition. Completely hypoallergenic, waterproof, and guaranteed against tarnishing.
          {% endif %}
        </p>

        <!-- Spec Badges -->
        <div class="grid grid-cols-2 gap-3 text-xs font-mono text-[#1E1A17] pt-2">
          <div class="p-3 rounded-xl bg-[#FAF8F5] border border-[#D8C39A]/40 flex items-center gap-2">
            <span>🛡️</span>
            <span>Lifetime Anti-Tarnish</span>
          </div>
          <div class="p-3 rounded-xl bg-[#FAF8F5] border border-[#D8C39A]/40 flex items-center gap-2">
            <span>⚡</span>
            <span>Same-Day Mumbai Dispatch</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
          {% if product != blank and product.available %}
            <button
              type="button"
              data-quick-add
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              class="btn-primary w-full sm:flex-1 min-h-[48px] h-12 text-xs font-mono uppercase tracking-wider font-bold cursor-pointer"
            >
              <span>Add to Bag • {{ product.price | money }}</span>
            </button>
          {% else %}
            <a
              href="/collections/all"
              class="btn-primary w-full sm:flex-1 min-h-[48px] h-12 text-xs font-mono uppercase tracking-wider font-bold no-underline"
            >
              <span>Explore The Suite</span>
            </a>
          {% endif %}

          {% if product != blank %}
            <a
              href="{{ product.url }}"
              class="btn-secondary w-full sm:w-auto min-h-[48px] h-12 px-6 text-xs font-mono uppercase tracking-wider font-bold no-underline"
            >
              <span>Inspect Suite</span>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

  </div>
</section>
