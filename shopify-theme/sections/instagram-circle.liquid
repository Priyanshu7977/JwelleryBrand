{% schema %}
{
  "name": "Act 07 — Instagram Atelier",
  "settings": [
    {
      "type": "text",
      "id": "act_tag",
      "label": "Act Tag",
      "default": "Act 07 — Instagram Atelier"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The live community lookbook"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram Handle",
      "default": "@celestiaamor.in"
    }
  ],
  "presets": [
    {
      "name": "Act 07 — Instagram Atelier"
    }
  ]
}
{% endschema %}

<section
  id="section-instagram"
  class="relative w-full py-16 sm:py-20 md:py-24 px-4 sm:px-6 md:px-10 lg:px-14 bg-[#FAF7F0] overflow-hidden border-t border-[#D8C39A]/30"
>
  <div class="max-w-7xl mx-auto space-y-8 sm:space-y-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[#D8C39A]/40 pb-4 sm:pb-5">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="text-[10px] sm:text-[11px] uppercase font-mono tracking-widest text-[#A37F3B] font-bold">
            {{ section.settings.act_tag }}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#A37F3B]"></span>
          <span class="text-xs text-[#786E65] font-mono">{{ section.settings.instagram_handle }}</span>
        </div>
        <h2 class="site-main-title text-[#1E1A17]">
          The live <span class="font-zapfino text-[#C2A875] font-normal tracking-normal lowercase inline-block px-1">community lookbook</span>
        </h2>
      </div>

      <a
        href="{{ settings.social_instagram_link | default: 'https://instagram.com/celestiaamor.in' }}"
        target="_blank"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#1E1A17] text-[#FAF7F0] text-xs uppercase font-bold tracking-widest hover:bg-[#38312B] active:scale-[0.98] transition-all shadow-md shrink-0 no-underline"
      >
        <span>Follow {{ section.settings.instagram_handle }}</span>
        <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>

    <!-- Story Highlights Bar -->
    <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto pb-1 justify-start sm:justify-center">
      <div class="flex flex-col items-center gap-1 shrink-0">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full p-0.5 bg-gradient-to-tr from-[#D8C39A] via-[#A37F3B] to-[#EADCD5] shadow-md">
          <div class="w-full h-full rounded-full overflow-hidden border-2 border-white bg-[#FAF7F0]">
            <img src="{{ 'pink-blue-bangles.jpg' | asset_url }}" alt="Reviews" class="w-full h-full object-cover" />
          </div>
        </div>
        <span class="text-[10px] sm:text-[11px] font-bold text-[#1E1A17]">Reviews 🧿✨</span>
      </div>

      <div class="flex flex-col items-center gap-1 shrink-0">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full p-0.5 bg-gradient-to-tr from-[#D8C39A] via-[#A37F3B] to-[#EADCD5] shadow-md">
          <div class="w-full h-full rounded-full overflow-hidden border-2 border-white bg-[#FAF7F0]">
            <img src="{{ 'desi-barbie-hamper.jpg' | asset_url }}" alt="Hampers" class="w-full h-full object-cover" />
          </div>
        </div>
        <span class="text-[10px] sm:text-[11px] font-bold text-[#1E1A17]">Hampers</span>
      </div>

      <div class="flex flex-col items-center gap-1 shrink-0">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full p-0.5 bg-gradient-to-tr from-[#D8C39A] via-[#A37F3B] to-[#EADCD5] shadow-md">
          <div class="w-full h-full rounded-full overflow-hidden border-2 border-white bg-[#FAF7F0]">
            <img src="{{ 'polaroids-20.jpg' | asset_url }}" alt="Customer Photos" class="w-full h-full object-cover" />
          </div>
        </div>
        <span class="text-[10px] sm:text-[11px] font-bold text-[#1E1A17]">Photos</span>
      </div>

      <div class="flex flex-col items-center gap-1 shrink-0">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full p-0.5 bg-gradient-to-tr from-[#D8C39A] via-[#A37F3B] to-[#EADCD5] shadow-md">
          <div class="w-full h-full rounded-full overflow-hidden border-2 border-white bg-[#FAF7F0]">
            <img src="{{ 'white-bangles.jpg' | asset_url }}" alt="Bangles" class="w-full h-full object-cover" />
          </div>
        </div>
        <span class="text-[10px] sm:text-[11px] font-bold text-[#1E1A17]">Bangles</span>
      </div>

      <div class="flex flex-col items-center gap-1 shrink-0">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full p-0.5 bg-gradient-to-tr from-[#D8C39A] via-[#A37F3B] to-[#EADCD5] shadow-md">
          <div class="w-full h-full rounded-full overflow-hidden border-2 border-white bg-[#FAF7F0]">
            <img src="{{ 'red-emerald-set.jpg' | asset_url }}" alt="Collabs" class="w-full h-full object-cover" />
          </div>
        </div>
        <span class="text-[10px] sm:text-[11px] font-bold text-[#1E1A17]">Collabs</span>
      </div>
    </div>

    <!-- Editorial Collage Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      <div class="relative rounded-2xl overflow-hidden bg-[#F3ECE1] shadow-sm hover:shadow-lg transition-all duration-500 aspect-square -rotate-1 hover:rotate-0 hover:scale-105">
        <img src="{{ 'pink-blue-bangles.jpg' | asset_url }}" alt="Bangles Stack" class="w-full h-full object-cover" />
      </div>
      <div class="relative rounded-2xl overflow-hidden bg-[#F3ECE1] shadow-sm hover:shadow-lg transition-all duration-500 aspect-square rotate-1 hover:rotate-0 hover:scale-105">
        <img src="{{ 'desi-barbie-hamper.jpg' | asset_url }}" alt="Hamper Velvet" class="w-full h-full object-cover" />
      </div>
      <div class="relative rounded-2xl overflow-hidden bg-[#F3ECE1] shadow-sm hover:shadow-lg transition-all duration-500 aspect-square -rotate-2 hover:rotate-0 hover:scale-105">
        <img src="{{ 'red-emerald-set.jpg' | asset_url }}" alt="Emerald Suite" class="w-full h-full object-cover" />
      </div>
      <div class="relative rounded-2xl overflow-hidden bg-[#F3ECE1] shadow-sm hover:shadow-lg transition-all duration-500 aspect-square rotate-2 hover:rotate-0 hover:scale-105">
        <img src="{{ 'white-bangles.jpg' | asset_url }}" alt="White Bangles" class="w-full h-full object-cover" />
      </div>
      <div class="relative rounded-2xl overflow-hidden bg-[#F3ECE1] shadow-sm hover:shadow-lg transition-all duration-500 aspect-square -rotate-1 hover:rotate-0 hover:scale-105">
        <img src="{{ 'anti-tarnish-rings.jpg' | asset_url }}" alt="Anti-Tarnish Rings" class="w-full h-full object-cover" />
      </div>
      <div class="relative rounded-2xl overflow-hidden bg-[#F3ECE1] shadow-sm hover:shadow-lg transition-all duration-500 aspect-square rotate-1 hover:rotate-0 hover:scale-105">
        <img src="{{ 'purple-tulip-hamper.jpg' | asset_url }}" alt="Floral Hamper" class="w-full h-full object-cover" />
      </div>
    </div>

  </div>
</section>
