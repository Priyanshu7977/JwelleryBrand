{% schema %}
{
  "name": "Celestia Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Join the Celestia Private Circle"
    }
  ]
}
{% endschema %}

<footer style="background-color: #181411; color: #FAF7F0;" class="relative z-30 w-full border-t border-[#D8C39A]/40 pt-16 sm:pt-20 pb-12 pb-safe px-4 sm:px-6 md:px-10 lg:px-14 overflow-hidden selection:bg-[#D8C39A] selection:text-[#181411]">
  <div class="relative max-w-7xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Signature Quote Header -->
    <div class="text-center space-y-4 pb-10 border-b border-[#D8C39A]/25">
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-[#28231F] border border-[#D8C39A]/40 text-[11px] uppercase font-mono tracking-widest text-[#D8C39A] font-bold">
        <span>✨ The Mumbai Atelier MMXXVI</span>
      </div>
      <h2 class="site-main-title text-[#FAF7F0] max-w-4xl mx-auto">
        Where timeless <span class="font-zapfino text-[#D8C39A] font-normal lowercase inline-block px-1">charm</span> meets everyday <span class="font-zapfino text-[#D8C39A] font-normal lowercase inline-block px-1">grace</span>
      </h2>
    </div>

    <!-- 4-Column Editorial Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-12 border-b border-[#D8C39A]/25">
      <!-- Col 1: Identity & Concierge -->
      <div class="lg:col-span-4 space-y-4">
        <span class="text-3xl sm:text-4xl uppercase tracking-wider block font-bold text-[#FAF7F0]">
          CEL<span class="font-light lowercase text-[#D8C39A]">estia</span>
        </span>
        <p class="text-xs uppercase tracking-[0.3em] text-[#D8C39A] font-mono font-bold">redefined for all</p>
        <p class="text-xs text-[#EDE6DA]/70 leading-relaxed font-sans max-w-sm">
          Handcrafted anti-tarnish fine jewellery, sculpted cuffs, and bespoke keepsake hampers. Curated in Mumbai, delivered worldwide.
        </p>
      </div>

      <!-- Col 2: Curated Collections -->
      <div class="lg:col-span-3 space-y-3 text-xs">
        <h4 class="text-[11px] uppercase font-mono tracking-widest text-[#D8C39A] font-bold">The Collections</h4>
        <ul class="space-y-2 list-none p-0">
          <li><a href="/collections/all" class="text-[#EDE6DA]/80 hover:text-[#FAF7F0] no-underline">Fine Jewellery Suites</a></li>
          <li><a href="/collections" class="text-[#EDE6DA]/80 hover:text-[#FAF7F0] no-underline">Sculpted Wave Bangles</a></li>
          <li><a href="/pages/gifting" class="text-[#EDE6DA]/80 hover:text-[#FAF7F0] no-underline">Bespoke Gifting Hampers</a></li>
          <li><a href="/collections/all" class="text-[#EDE6DA]/80 hover:text-[#FAF7F0] no-underline">Anti-Tarnish Pearls</a></li>
        </ul>
      </div>

      <!-- Col 3: Atelier Heritage -->
      <div class="lg:col-span-2 space-y-3 text-xs">
        <h4 class="text-[11px] uppercase font-mono tracking-widest text-[#D8C39A] font-bold">Atelier</h4>
        <ul class="space-y-2 list-none p-0">
          <li><a href="/pages/the-world" class="text-[#EDE6DA]/80 hover:text-[#FAF7F0] no-underline">The World</a></li>
          <li><a href="/blogs/journal" class="text-[#EDE6DA]/80 hover:text-[#FAF7F0] no-underline">Editorial Journal</a></li>
          <li><a href="/pages/contact" class="text-[#EDE6DA]/80 hover:text-[#FAF7F0] no-underline">Studio Concierge</a></li>
          <li><a href="/policies/terms-of-service" class="text-[#EDE6DA]/80 hover:text-[#FAF7F0] no-underline">Shipping & Returns</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter & WhatsApp -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-[11px] uppercase font-mono tracking-widest text-[#D8C39A] font-bold">{{ section.settings.newsletter_heading }}</h4>
        <form method="post" action="/contact#contact_form" class="space-y-2">
          <input type="hidden" name="form_type" value="customer" />
          <input type="hidden" name="contact[tags]" value="newsletter" />
          <div class="relative">
            <input
              type="email"
              name="contact[email]"
              placeholder="Enter your email..."
              required
              class="w-full h-11 pl-4 pr-24 rounded-full bg-[#28231F] border border-[#D8C39A]/40 text-xs text-[#FAF7F0] placeholder:text-[#EDE6DA]/50 focus:outline-none focus:border-[#D8C39A]"
            />
            <button
              type="submit"
              class="absolute right-1 top-1 bottom-1 px-4 rounded-full bg-[#D8C39A] text-[#1E1A17] text-[11px] uppercase font-bold tracking-wider hover:bg-[#E5D2AD] transition-all cursor-pointer"
            >
              Join
            </button>
          </div>
        </form>
        <p class="text-[10px] text-[#EDE6DA]/60 font-mono">Mumbai Studio Concierge: 10 AM – 8 PM IST</p>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div class="pt-6 text-[11px] text-[#EDE6DA]/50 font-mono flex flex-col sm:flex-row justify-between items-center gap-2">
      <span>© {{ 'now' | date: '%Y' }} Celestia Atelier & Fine Adornments. Handcrafted in Mumbai.</span>
      <span>Same-Day Mumbai Express Delivery • Pan-India Free Shipping</span>
    </div>
  </div>
</footer>
